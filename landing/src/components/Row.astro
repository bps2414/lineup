---
// The hero: a home row where one game is lifted, carried three places, dropped and pinned.
// Tiles are plain colour blocks standing in for covers, so no game art is shown.
import Glyph from './Glyph.astro';

interface Props {
  caption: string;
  keys: { lift: string; carry: string; drop: string; pin: string };
}

const { caption, keys } = Astro.props;
const covers = ['#1f5f63', '#c8553d', '#b08a2e', '#34437a', '#5d6b34', '#6b3159', '#8c7a63'];
---

<figure class="row-fig">
  <div class="row" role="img" aria-label={caption}>
    {
      covers.map((c, i) => (
        <div class:list={['tile', `t${i}`]} style={`--c:${c}`}>
          {i === 1 && (
            <span class="pin" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="100%" height="100%">
                <path d="M9 3h6l-1 6 3 3v2h-4.2l-.8 7-.8-7H7v-2l3-3z" fill="currentColor" />
              </svg>
            </span>
          )}
        </div>
      ))
    }
  </div>
  <ol class="keys" aria-hidden="true">
    <li class="k1"><b><Glyph name="✕" /></b>{keys.lift}</li>
    <li class="k2"><b><Glyph name="▶" /></b>{keys.carry}</li>
    <li class="k3"><b><Glyph name="✕" /></b>{keys.drop}</li>
    <li class="k4"><b><Glyph name="□" /></b>{keys.pin}</li>
  </ol>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  /* The figure is the container, so cqw in the row means the row's own width. */
  .row-fig {
    margin: 0;
    container-type: inline-size;
  }

  .row {
    --gap: 2cqw;
    --slot: calc((100cqw + var(--gap)) / 7);
    position: relative;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: var(--gap);
    padding-top: 4cqw;
  }

  .tile {
    position: relative;
    aspect-ratio: 1;
    border-radius: 1.6cqw;
    background:
      linear-gradient(160deg, rgb(255 255 255 / 0.14), transparent 45%),
      linear-gradient(to top, rgb(0 0 0 / 0.35), transparent 60%),
      var(--c);
  }

  /* Resting state is the end of the gesture, so reduced motion shows the result. */
  .t1 {
    z-index: 1;
    transform: translateX(calc(3 * var(--slot)));
    box-shadow: 0 0 0 0.5cqw #fff;
  }

  .t2,
  .t3,
  .t4 {
    transform: translateX(calc(-1 * var(--slot)));
  }

  .pin {
    position: absolute;
    top: -1.4cqw;
    right: -1.4cqw;
    width: 4cqw;
    height: 4cqw;
    padding: 0.7cqw;
    border-radius: 50%;
    background: #fff;
    color: #000;
  }

  .keys {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--step-0);
    font-weight: 600;
  }

  .keys li {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }

  .keys b {
    display: inline-flex;
    color: var(--ink-soft);
  }

  figcaption {
    margin-top: 1rem;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  @media (prefers-reduced-motion: no-preference) {
    .row {
      animation: row 11s infinite;
    }
    .t1 {
      animation: carry 11s infinite;
    }
    .t2 {
      animation: make-room-2 11s infinite;
    }
    .t3 {
      animation: make-room-3 11s infinite;
    }
    .t4 {
      animation: make-room-4 11s infinite;
    }
    .pin {
      animation: pin 11s infinite;
    }
    .k1 {
      animation: k1 11s infinite;
    }
    .k2 {
      animation: k2 11s infinite;
    }
    .k3 {
      animation: k3 11s infinite;
    }
    .k4 {
      animation: k4 11s infinite;
    }
  }

  @keyframes row {
    0% {
      opacity: 0;
    }
    3%,
    88% {
      opacity: 1;
    }
    95%,
    100% {
      opacity: 0;
    }
  }

  @keyframes carry {
    0%,
    8% {
      transform: none;
      box-shadow: 0 0 0 0.5cqw #fff;
      animation-timing-function: cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    14% {
      transform: translateY(-3cqw) scale(1.06);
      box-shadow: 0 0 0 0.5cqw #fff, 0 2.5cqw 4cqw rgb(255 255 255 / 0.12);
      animation-timing-function: ease-in-out;
    }
    46% {
      transform: translateX(calc(3 * var(--slot))) translateY(-3cqw) scale(1.06);
      box-shadow: 0 0 0 0.5cqw #fff, 0 2.5cqw 4cqw rgb(255 255 255 / 0.12);
      animation-timing-function: cubic-bezier(0.5, 0, 0.3, 1.3);
    }
    52%,
    100% {
      transform: translateX(calc(3 * var(--slot)));
      box-shadow: 0 0 0 0.5cqw #fff;
    }
  }

  @keyframes make-room-2 {
    0%,
    20% {
      transform: none;
    }
    26%,
    100% {
      transform: translateX(calc(-1 * var(--slot)));
    }
  }

  @keyframes make-room-3 {
    0%,
    29% {
      transform: none;
    }
    35%,
    100% {
      transform: translateX(calc(-1 * var(--slot)));
    }
  }

  @keyframes make-room-4 {
    0%,
    38% {
      transform: none;
    }
    44%,
    100% {
      transform: translateX(calc(-1 * var(--slot)));
    }
  }

  @keyframes pin {
    0%,
    57% {
      opacity: 0;
      transform: scale(0.4);
    }
    61% {
      opacity: 1;
      transform: scale(1.15);
    }
    64%,
    100% {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes k1 {
    0%,
    6%,
    17%,
    100% {
      opacity: 0.3;
    }
    9%,
    14% {
      opacity: 1;
    }
  }

  @keyframes k2 {
    0%,
    15%,
    47%,
    100% {
      opacity: 0.3;
    }
    18%,
    44% {
      opacity: 1;
    }
  }

  @keyframes k3 {
    0%,
    45%,
    55%,
    100% {
      opacity: 0.3;
    }
    47%,
    52% {
      opacity: 1;
    }
  }

  @keyframes k4 {
    0%,
    55%,
    100% {
      opacity: 0.3;
    }
    58%,
    86% {
      opacity: 1;
    }
  }
</style>
